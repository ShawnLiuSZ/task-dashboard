{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskBoard",
  "version": "0.6.2",
  "identifier": "com.shawnliu.taskboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TaskBoard",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.github.com https://*.github.com ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0MUZCQ0Q3QTUyMzcyRUQKUldUdGNpT2wxN3dmdEhoTmF4VHcrK0pCb09nOFVmY3JGSGh0WEw4NDUxQnVFM21ldWpNd1EyZ0gK",
      "endpoints": [
        "https://github.com/ShawnLiuSZ/task-dashboard/releases/latest/download/latest.json"
      ]
    }
  }
}
