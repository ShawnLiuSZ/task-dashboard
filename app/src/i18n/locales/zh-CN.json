  "agent.guide.interrupt.when": "中途停止 / 会话中断",
  "agent.guide.interrupt.action": "record_session(issue, <会话id>, \"<agent名>\")",
  "agent.guide.handoff.when": "用户说「生成交接任务」",
  "agent.guide.handoff.action": "record_handoff(issue, \"<已做/未做/卡点/如何恢复>\")",
  "agent.guide.done.when": "任务完成",
  "agent.guide.done.action": "update_task_status(issue, \"已完成\") + clear_session(issue)",
  "board.unmappedHint": "未映射"
}
