# --- Build artifacts ---
app/src-tauri/target/
app/node_modules/
app/dist/
node_modules/
dist/

# --- OS / editor ---
.DS_Store
.idea/

# --- Agent tooling memory (local only, not project source) ---
.workbuddy/
.worktrees

# --- Claude Code local-only files (per-developer, NEVER commit) ---
# CLAUDE.md is the project-level instruction (committed).
# CLAUDE.local.md is a per-developer override that should not be tracked.
CLAUDE.local.md
# .claude/settings.json may be committed (shared settings).
# .claude/settings.local.json is per-developer; never commit.
.claude/settings.local.json

# --- Override global ~/.gitignore_global §38 (AGENTS.*) ---
# Global rule wrongly ignores our canonical AGENTS.md. Re-include it locally.
!AGENTS.md
# 同一条全局规则还会吞掉前端共享模块 app/src/agents.ts，一并收回。
!app/src/agents.ts

# --- Override global §37/§40 (.opencode/*, opencode.json) (#177) ---
# TaskBoard agent hooks are project source (shared with team), not personal config.
!opencode.json
!.opencode/
!.opencode/**
